<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIニュースまとめ</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f5f5f7;
    --card-bg: #ffffff;
    --text: #1a1a2e;
    --text-muted: #6b7280;
    --accent: #4f46e5;
    --accent-bg: rgba(79,70,229,0.10);
    --border: rgba(0,0,0,0.06);
    --shadow: rgba(0,0,0,0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --card-bg: #1a1a22;
      --text: #e8e8ec;
      --text-muted: #9297a3;
      --accent: #a5b4fc;
      --accent-bg: rgba(165,180,252,0.14);
      --border: rgba(255,255,255,0.08);
      --shadow: rgba(0,0,0,0.5);
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", sans-serif;
    max-width: 640px;
    margin: 0 auto;
    padding: 28px 16px 56px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.55;
  }
  header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .updated { color: var(--text-muted); font-size: 0.8rem; }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 12px;
    box-shadow: 0 1px 2px var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--shadow);
  }
  .source {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }
  .title a,
  .title a:visited {
    color: var(--accent);
    text-decoration: none;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .title a:hover,
  .title a:focus-visible { text-decoration: underline; }
  .date { color: var(--text-muted); font-size: 0.75rem; margin-top: 8px; }
</style>
</head>
<body>
  <header>
    <h1>AIニュースまとめ</h1>
    <div class="updated">最終更新: {{ generated_at }}</div>
  </header>
  {% for article in articles %}
  <div class="card">
    <div class="source">{{ article.source }}</div>
    <div class="title"><a href="{{ article.link }}" target="_blank" rel="noopener">{{ article.title }}</a></div>
    <div class="date">{{ article.published_display }}</div>
  </div>
  {% endfor %}
</body>
</html>
