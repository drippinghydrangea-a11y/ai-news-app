<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AIニュースまとめ</title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #f5f5f7;
    --card-bg: #ffffff;
    --text: #1a1a2e;
    --text-muted: #6b7280;
    --accent: #4f46e5;
    --accent-bg: rgba(79,70,229,0.10);
    --border: rgba(0,0,0,0.06);
    --shadow: rgba(0,0,0,0.08);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f0f14;
      --card-bg: #1a1a22;
      --text: #e8e8ec;
      --text-muted: #9297a3;
      --accent: #a5b4fc;
      --accent-bg: rgba(165,180,252,0.14);
      --border: rgba(255,255,255,0.08);
      --shadow: rgba(0,0,0,0.5);
    }
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", sans-serif;
    max-width: 640px;
    margin: 0 auto;
    padding: 28px 16px 56px;
    background: var(--bg);
    color: var(--text);
    line-height: 1.55;
  }
  header {
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }
  .updated { color: var(--text-muted); font-size: 0.8rem; }
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px 16px;
    margin-bottom: 12px;
    box-shadow: 0 1px 2px var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px var(--shadow);
  }
  .source {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 3px 10px;
    border-radius: 999px;
    margin-bottom: 10px;
  }
  .title a,
  .title a:visited {
    color: var(--accent);
    text-decoration: none;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .title a:hover,
  .title a:focus-visible { text-decoration: underline; }
  .date { color: var(--text-muted); font-size: 0.75rem; margin-top: 8px; }
  .summary { font-size: 0.88rem; color: var(--text); margin-top: 8px; line-height: 1.5; }
  .stars { font-size: 0.85rem; color: var(--accent); margin-top: 6px; letter-spacing: 1px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 16px; }
  .tab-btn {
    font: inherit;
    font-weight: 600;
    font-size: 0.85rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--card-bg);
    color: var(--text-muted);
    cursor: pointer;
  }
  .tab-btn.active {
    background: var(--accent-bg);
    color: var(--accent);
    border-color: var(--accent);
  }
  body[data-view="unread"] .card.is-read { display: none; }
  body[data-view="read"] .card:not(.is-read) { display: none; }
  body[data-view="recommended"] .card:not([data-recommended="true"]) { display: none; }
  .empty-state {
    text-align: center;
    color: var(--text-muted);
    padding: 48px 0;
    font-size: 0.9rem;
  }
</style>
</head>
<body data-view="unread">
  <header>
    <h1>AIニュースまとめ</h1>
    <div class="updated">最終更新: {{ generated_at }}</div>
  </header>
  <div class="tabs">
    <button class="tab-btn active" data-view="unread" type="button">未読</button>
    <button class="tab-btn" data-view="read" type="button">既読</button>
    <button class="tab-btn" data-view="recommended" type="button">おすすめ</button>
  </div>
  <div class="empty-state" id="empty-state" hidden></div>
  {% for article in articles %}
  <div class="card" data-link="{{ article.link }}" data-recommended="{{ 'true' if article.recommended else 'false' }}">
    <div class="source">{{ article.source }}</div>
    <div class="title"><a href="{{ article.link }}" target="_blank" rel="noopener">{{ article.title }}</a></div>
    <div class="date">{{ article.published_display }}</div>
    {% if article.summary %}
    <div class="summary">{{ article.summary }}</div>
    {% endif %}
    {% if article.star %}
    <div class="stars">{{ '★' * article.star }}{{ '☆' * (5 - article.star) }}</div>
    {% endif %}
  </div>
  {% endfor %}
  <script>
  (function () {
    var STORAGE_KEY = 'aiNewsApp.readLinks';
    var readLinks;
    try {
      readLinks = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));
    } catch (e) {
      readLinks = new Set();
    }

    function persist() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(Array.from(readLinks)));
      } catch (e) {
        /* localStorage unavailable; read state just won't persist */
      }
    }

    var cards = Array.prototype.slice.call(document.querySelectorAll('.card'));
    var emptyState = document.getElementById('empty-state');
    var tabButtons = Array.prototype.slice.call(document.querySelectorAll('.tab-btn'));

    function applyReadState() {
      cards.forEach(function (card) {
        card.classList.toggle('is-read', readLinks.has(card.getAttribute('data-link')));
      });
    }

    function updateEmptyState() {
      var view = document.body.getAttribute('data-view');
      var visibleCount = cards.filter(function (card) {
        if (view === 'read') return card.classList.contains('is-read');
        if (view === 'recommended') return card.getAttribute('data-recommended') === 'true';
        return !card.classList.contains('is-read');
      }).length;
      emptyState.hidden = visibleCount !== 0;
      var messages = {
        unread: 'すべて既読です 🎉',
        read: 'まだ既読の記事がありません',
        recommended: 'おすすめ記事がありません',
      };
      emptyState.textContent = messages[view] || '';
    }

    tabButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        tabButtons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        document.body.setAttribute('data-view', btn.getAttribute('data-view'));
        updateEmptyState();
      });
    });

    cards.forEach(function (card) {
      var link = card.querySelector('.title a');
      if (!link) return;
      link.addEventListener('click', function () {
        readLinks.add(card.getAttribute('data-link'));
        persist();
        applyReadState();
        updateEmptyState();
      });
    });

    applyReadState();
    updateEmptyState();
  })();
  </script>
</body>
</html>
